# Copia este archivo como ".env" (en la misma carpeta) y rellena tus datos.
# El archivo .env está en .gitignore: nunca se subirá a GitHub.

# Token de tu integración interna de Notion (empieza por ntn_)
NOTION_TOKEN=ntn_pega_aqui_tu_token

# URL de tu base de datos de libros (o de la página que la contiene)
NOTION_DATABASE_ID=https://www.notion.so/tu-espacio/Libros-0123456789abcdef0123456789abcdef?v=...

# (Opcional) Nombre de la columna del autor. Si no se indica, se busca una
# columna llamada "Autor" o "Author" de tipo texto, selección o selección múltiple.
# NOTION_AUTHOR_PROPERTY=Autor
